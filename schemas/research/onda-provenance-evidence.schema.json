{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinekernel.dev/schemas/research/onda-provenance-evidence.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "observation_timestamp_utc", "github_commit", "github_release", "github_pr_41", "npm", "records"],
  "properties": {
    "schema_version": {"const": "cinekernel.research.onda.r0.01.v1"},
    "observation_timestamp_utc": {"type": "string", "format": "date-time"},
    "github_commit": {"$ref": "#/$defs/githubCommit"},
    "github_release": {"$ref": "#/$defs/githubRelease"},
    "github_pr_41": {"$ref": "#/$defs/githubPr"},
    "npm": {"$ref": "#/$defs/npm"},
    "records": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verification": {"type": "object", "additionalProperties": false, "required": ["verified", "reason", "verified_at"], "properties": {"verified": {"type": "boolean"}, "reason": {"type": "string", "minLength": 1}, "verified_at": {"type": ["string", "null"], "format": "date-time"}}},
    "githubCommit": {"type": "object", "additionalProperties": false, "required": ["sha", "tree", "author_date", "committer_date", "verification"], "properties": {"sha": {"const": "3ddf1780c9799bf038ac90cec7d8cadb61acafbe"}, "tree": {"const": "639df83ebf0262afccd6d021bf6d16ef19777d85"}, "author_date": {"type": "string", "format": "date-time"}, "committer_date": {"type": "string", "format": "date-time"}, "verification": {"$ref": "#/$defs/verification"}}},
    "asset": {"type": "object", "additionalProperties": false, "required": ["id", "name", "size", "digest"], "properties": {"id": {"const": 475692944}, "name": {"const": "onda-embed-kit-v0.2.16-x86_64-linux.tar.gz"}, "size": {"type": "integer", "minimum": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "githubRelease": {"type": "object", "additionalProperties": false, "required": ["id", "tag_name", "target_commitish", "tag_target", "published_at", "asset"], "properties": {"id": {"const": 353301462}, "tag_name": {"const": "v0.2.16"}, "target_commitish": {"type": "string", "minLength": 1}, "tag_target": {"$ref": "#/$defs/sha"}, "published_at": {"type": "string", "format": "date-time"}, "asset": {"$ref": "#/$defs/asset"}}},
    "githubPr": {"type": "object", "additionalProperties": false, "required": ["number", "title", "state", "merged_at", "merge_commit_sha"], "properties": {"number": {"const": 41}, "title": {"type": "string", "minLength": 1}, "state": {"const": "closed"}, "merged_at": {"type": "string", "format": "date-time"}, "merge_commit_sha": {"const": "3ddf1780c9799bf038ac90cec7d8cadb61acafbe"}}},
    "repository": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object", "additionalProperties": false, "required": ["type", "url"], "properties": {"type": {"type": "string", "minLength": 1}, "url": {"type": "string", "minLength": 1}, "directory": {"type": "string", "minLength": 1}}}]},
    "dist": {"type": "object", "additionalProperties": false, "required": ["tarball", "shasum", "integrity", "file_count", "unpacked_size", "signatures"], "properties": {"tarball": {"type": "string", "format": "uri"}, "shasum": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "integrity": {"type": "string", "pattern": "^sha512-[A-Za-z0-9+/=]+$"}, "file_count": {"type": "integer", "minimum": 1}, "unpacked_size": {"type": "integer", "minimum": 1}, "signatures": {"type": "array", "minItems": 1, "items": {"type": "object"}}}},
    "npm": {"type": "object", "additionalProperties": false, "required": ["name", "version", "license", "repository", "published_at", "observed_public_versions", "dist_tags", "dist"], "properties": {"name": {"const": "onda-engine"}, "version": {"const": "0.6.1"}, "license": {"type": "string", "minLength": 1}, "repository": {"$ref": "#/$defs/repository"}, "published_at": {"type": "string", "format": "date-time"}, "observed_public_versions": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}}, "dist_tags": {"type": "object", "additionalProperties": {"type": "string"}, "required": ["latest"]}, "dist": {"$ref": "#/$defs/dist"}}},
    "record": {"type": "object", "additionalProperties": false, "required": ["id", "value", "evidence_source", "observation_timestamp_utc", "raw_evidence_sha256", "verification_method", "computed_or_asserted"], "properties": {"id": {"type": "string", "pattern": "^EVID-[A-Z0-9.-]+$"}, "value": {}, "evidence_source": {"type": "string", "minLength": 1}, "observation_timestamp_utc": {"type": "string", "format": "date-time"}, "raw_evidence_sha256": {"$ref": "#/$defs/sha256"}, "verification_method": {"type": "string", "minLength": 1}, "computed_or_asserted": {"enum": ["COMPUTED_FROM_LIVE_EVIDENCE", "ASSERTED_FROM_RECORDED_EVIDENCE"]}}}
  }
}
