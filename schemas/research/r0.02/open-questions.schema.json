{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "minLength": 1,
      "type": "string"
    },
    "data": {
      "additionalProperties": false,
      "properties": {
        "open_questions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "defer_to": {
                "items": {
                  "enum": [
                    "R0.03",
                    "R0.04",
                    "R0.05",
                    "R0.06",
                    "R0.07",
                    "R0.08"
                  ],
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "id": {
                "pattern": "^[A-Z][A-Z0-9.-]*(?:-[A-Z0-9.-]+)+$",
                "type": "string"
              },
              "question": {
                "minLength": 1,
                "type": "string"
              },
              "source_refs": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "defer_to",
              "id",
              "question",
              "source_refs"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "open_questions"
      ],
      "type": "object"
    },
    "generated_at": {
      "format": "date-time",
      "type": "string"
    },
    "model_ref": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "$schema",
    "data",
    "generated_at",
    "model_ref",
    "schema_version"
  ],
  "type": "object"
}
