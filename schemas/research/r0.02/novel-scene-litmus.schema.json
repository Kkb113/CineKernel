{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "minLength": 1,
      "type": "string"
    },
    "data": {
      "additionalProperties": false,
      "properties": {
        "novel_scene_litmus": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "asset_truthfulness": {
                "minLength": 1,
                "type": "string"
              },
              "capability_decomposition": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "dimension": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "evidence_scope": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "required_primitive": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "source_refs": {
                      "items": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "minItems": 1,
                      "type": "array"
                    },
                    "status": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "dimension",
                    "evidence_scope",
                    "required_primitive",
                    "source_refs",
                    "status"
                  ],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array"
              },
              "editability": {
                "minLength": 1,
                "type": "string"
              },
              "inspectability": {
                "minLength": 1,
                "type": "string"
              },
              "limitations": {
                "minLength": 1,
                "type": "string"
              },
              "litmus_id": {
                "pattern": "^[A-Z][A-Z0-9.-]*(?:-[A-Z0-9.-]+)+$",
                "type": "string"
              },
              "required_primitives": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "scene": {
                "minLength": 1,
                "type": "string"
              },
              "source_refs": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "surface_comparison": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "result": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "surface_id": {
                      "pattern": "^[A-Z][A-Z0-9.-]*(?:-[A-Z0-9.-]+)+$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "result",
                    "surface_id"
                  ],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array"
              },
              "verdict": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "asset_truthfulness",
              "capability_decomposition",
              "editability",
              "inspectability",
              "limitations",
              "litmus_id",
              "required_primitives",
              "scene",
              "source_refs",
              "surface_comparison",
              "verdict"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "novel_scene_litmus"
      ],
      "type": "object"
    },
    "generated_at": {
      "format": "date-time",
      "type": "string"
    },
    "model_ref": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "$schema",
    "data",
    "generated_at",
    "model_ref",
    "schema_version"
  ],
  "type": "object"
}
