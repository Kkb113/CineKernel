{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinekernel.dev/schemas/research/onda-upstream-lock.schema.json",
  "type": "object",
  "required": ["schema_version", "cinekernel_base_revision", "repository", "pinned_commit", "pinned_tree", "license", "lockfiles", "release_streams", "package_versions", "unresolved"],
  "properties": {
    "schema_version": {"const": "cinekernel.research.onda.r0.01.v1"},
    "cinekernel_base_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pinned_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pinned_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository": {"type": "string"},
    "license": {"type": "object", "required": ["declared_spdx", "license_sha256", "future_license_sha256", "notice_sha256"]},
    "lockfiles": {"type": "object", "required": ["cargo_lock_sha256", "pnpm_lock_sha256"]},
    "release_streams": {"type": "array", "minItems": 1},
    "package_versions": {"type": "array", "minItems": 1},
    "unresolved": {"type": "array"}
  }
}
