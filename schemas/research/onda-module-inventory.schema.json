{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinekernel.dev/schemas/research/onda-module-inventory.schema.json",
  "type": "object",
  "required": ["schema_version", "pinned_commit", "modules"],
  "properties": {
    "schema_version": {"const": "cinekernel.research.onda.r0.01.v1"},
    "pinned_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "modules": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["ecosystem", "name", "path", "classification", "status"]}}
  }
}
