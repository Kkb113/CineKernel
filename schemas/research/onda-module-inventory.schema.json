{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinekernel.dev/schemas/research/onda-module-inventory.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "pinned_commit", "modules"],
  "properties": {
    "schema_version": {"const": "cinekernel.research.onda.r0.01.v1"},
    "pinned_commit": {"const": "3ddf1780c9799bf038ac90cec7d8cadb61acafbe"},
    "modules": {"type": "array", "minItems": 34, "uniqueItems": true, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["ecosystem", "name", "version", "path", "classification", "status"],
      "properties": {
        "ecosystem": {"enum": ["rust", "javascript"]}, "name": {"type": "string", "minLength": 1}, "version": {"type": ["string", "null"]},
        "license": {"type": ["string", "null"]}, "path": {"type": "string", "pattern": "^(packages|apps)/"}, "classification": {"type": "string", "minLength": 1},
        "private": {"type": ["boolean", "null"]}, "status": {"enum": ["VERIFIED_AT_PIN", "DOCUMENTED_OR_COMMENTED_BUT_ABSENT"]}
      }
    }}
  }
}
