{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinekernel.dev/schemas/phase0/benchmark-intent.schema.json",
  "title": "BenchmarkIntentSpec (temporary Phase 0 interchange; not VideoIR)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "notice", "cases"],
  "properties": {
    "schema_version": {"const": "phase0.benchmark-intent.v1"},
    "notice": {"const": "A Phase 0 benchmark interchange format, not the future CineKernel VideoIR."},
    "cases": {"type": "array", "minItems": 7, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "purpose", "duration_seconds", "resolution", "fps", "local_assets", "scene_boundaries_seconds", "expected_visual_events", "expected_audio_events", "expected_frame_count", "verification_points_seconds", "supported_engines"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "title": {"type": "string"},
        "purpose": {"type": "string"},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "resolution": {"type": "object", "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
        "fps": {"const": "30/1"},
        "local_assets": {"type": "array", "items": {"type": "string"}},
        "scene_boundaries_seconds": {"type": "array", "items": {"type": "number", "minimum": 0}},
        "expected_visual_events": {"type": "array", "items": {"type": "string"}},
        "expected_audio_events": {"type": "array", "items": {"type": "string"}},
        "expected_frame_count": {"type": "integer", "minimum": 1},
        "verification_points_seconds": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
        "supported_engines": {"type": "array", "minItems": 1, "items": {"enum": ["remotion", "hyperframes", "native-2d", "native-wgpu"]}}
      }
    }
  }
}

