{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinekernel.dev/schemas/phase0/benchmark-result.schema.json",
  "title": "CineKernel Phase 0.1 canonical benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonical_run_id", "canonical", "implementation_revision", "worktree_clean", "environment_id", "benchmark_spec_sha256", "upstream_lock_sha256", "engine", "engine_version", "upstream_commit", "case_id", "profile", "repetition", "warmup", "equivalence_level", "configuration", "timings_ms", "resources", "capabilities", "encoder", "verification", "exit_code", "timed_out", "warnings"],
  "properties": {
    "schema_version": {"const": "phase0.result.v2"},
    "canonical_run_id": {"type": "string", "minLength": 1},
    "canonical": {"const": true},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "implementation_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "worktree_clean": {"const": true},
    "environment_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "benchmark_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "upstream_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "engine": {"enum": ["remotion", "hyperframes", "native-2d", "native-wgpu"]},
    "engine_version": {"type": "string", "minLength": 1},
    "upstream_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "case_id": {"type": "string", "minLength": 1},
    "profile": {"enum": ["smoke", "full"]},
    "repetition": {"type": "integer", "minimum": 0},
    "warmup": {"type": "boolean"},
    "equivalence_level": {"enum": ["equivalent", "partial", "feasibility", "unsupported"]},
    "configuration": {"type": "object"},
    "timings_ms": {"$ref": "#/$defs/timings"},
    "resources": {"$ref": "#/$defs/resources"},
    "capabilities": {"$ref": "#/$defs/capabilities"},
    "encoder": {"type": "object"},
    "verification": {"type": "object", "required": ["passed", "issues"], "properties": {"passed": {"type": "boolean"}, "issues": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "exit_code": {"type": "integer"},
    "timed_out": {"type": "boolean"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "nullableNumber": {"type": ["number", "null"], "minimum": 0},
    "timings": {"type": "object", "additionalProperties": false, "required": ["preflight", "project_prepare", "engine_startup", "frame_production", "encode", "render_command", "artifact_verify", "end_to_end"], "properties": {"preflight": {"$ref": "#/$defs/nullableNumber"}, "project_prepare": {"$ref": "#/$defs/nullableNumber"}, "engine_startup": {"$ref": "#/$defs/nullableNumber"}, "frame_production": {"$ref": "#/$defs/nullableNumber"}, "encode": {"$ref": "#/$defs/nullableNumber"}, "render_command": {"$ref": "#/$defs/nullableNumber"}, "artifact_verify": {"$ref": "#/$defs/nullableNumber"}, "end_to_end": {"$ref": "#/$defs/nullableNumber"}}},
    "resources": {"type": "object", "additionalProperties": false, "required": ["peak_rss_bytes", "peak_temporary_disk_bytes", "maximum_queued_frame_bytes", "output_bytes"], "properties": {"peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0}, "peak_temporary_disk_bytes": {"type": ["integer", "null"], "minimum": 0}, "maximum_queued_frame_bytes": {"type": ["integer", "null"], "minimum": 0}, "output_bytes": {"type": ["integer", "null"], "minimum": 0}}},
    "capabilities": {"type": "object", "additionalProperties": false, "required": ["gpu_active", "gpu_backend", "gpu_adapter", "gpu_driver", "software_fallback", "capture_mode"], "properties": {"gpu_active": {"type": ["boolean", "null"]}, "gpu_backend": {"type": ["string", "null"]}, "gpu_adapter": {"type": ["string", "null"]}, "gpu_driver": {"type": ["string", "null"]}, "software_fallback": {"type": ["boolean", "null"]}, "capture_mode": {"type": ["string", "null"]}}}
  }
}
