{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinekernel.dev/schemas/phase0/benchmark-result.schema.json",
  "title": "CineKernel Phase 0 benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "timestamp_utc", "cinekernel_revision", "cinekernel_dirty", "environment_id", "engine", "engine_version", "upstream_commit", "case_id", "profile", "repetition", "configuration", "timings_ms", "resources", "capabilities", "verification", "exit_code", "warnings"],
  "properties": {
    "schema_version": {"const": "phase0.result.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "cinekernel_revision": {"type": "string"},
    "cinekernel_dirty": {"type": "boolean"},
    "environment_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "engine": {"enum": ["remotion", "hyperframes", "native-2d", "native-wgpu"]},
    "engine_version": {"type": "string"},
    "upstream_commit": {"type": ["string", "null"]},
    "case_id": {"type": "string"},
    "profile": {"enum": ["smoke", "full"]},
    "repetition": {"type": "integer", "minimum": 1},
    "configuration": {"type": "object"},
    "timings_ms": {"$ref": "#/$defs/timings"},
    "resources": {"type": "object"},
    "capabilities": {"type": "object"},
    "verification": {"type": "object", "required": ["passed", "issues"], "properties": {"passed": {"type": "boolean"}, "issues": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "exit_code": {"type": "integer"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "nullableNumber": {"type": ["number", "null"], "minimum": 0},
    "timings": {"type": "object", "required": ["prepare", "compile", "initialize", "frame_production", "encode", "verify", "total"], "properties": {"prepare": {"$ref": "#/$defs/nullableNumber"}, "compile": {"$ref": "#/$defs/nullableNumber"}, "initialize": {"$ref": "#/$defs/nullableNumber"}, "frame_production": {"$ref": "#/$defs/nullableNumber"}, "encode": {"$ref": "#/$defs/nullableNumber"}, "verify": {"$ref": "#/$defs/nullableNumber"}, "total": {"type": "number", "minimum": 0}}, "additionalProperties": false}
  }
}

